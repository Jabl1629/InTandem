# InTandem EMR backend — copy to .env for local dev, or set these in the Render
# dashboard (Environment) for the deployed service. NEVER commit real values.

# From the ElevenLabs dashboard:
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=

# Default phone to call if the console doesn't override it (E.164, e.g. +13035550142)
DEFAULT_TARGET_PHONE=

# Comma-separated allowed origins for CORS. Use the Pages origin in prod:
#   https://jabl1629.github.io
# (or * for quick local testing)
ALLOWED_ORIGINS=*

# Port (Render sets this automatically; 3001 for local dev)
PORT=3001

# Set MOCK=1 to force simulation mode even with a key (no real calls placed)
# MOCK=1
